  <main id="main">
    <section class="page-banner">
      <div class="container">
        <h1>Page Not Found</h1>
        <p>The page you are looking for may have moved or no longer exists.</p>
        <p style="margin-top:24px"><a class="btn btn-primary" href="/">Back to Home</a></p>
      </div>
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../generated/pages.json';
import { schemaFor } from '../lib/schema';

type Page = (typeof pages)[keyof typeof pages];

export function getStaticPaths() {
  return Object.entries(pages).map(([name, page]) => ({
    params: { slug: name === 'home' ? undefined : name },
    props: { name, page },
  }));
}

const { name, page } = Astro.props as { name: string; page: Page };
const html = import.meta.glob('../generated/pages/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const css = import.meta.glob('../generated/pages/*.css', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const body = html[`../generated/pages/${name}.html`].replaceAll('__TURNSTILE_SITE_KEY__', siteKey);
---
<BaseLayout
  title={page.title}
  description={page.description}
  path={page.route}
  image={page.image}
  lcpImage={page.lcpImage}
  lcpSrcset={page.lcpSrcset}
  lcpSizes={page.lcpSizes}
  schema={schemaFor(page)}
  pageCss={css[`../generated/pages/${name}.css`]}
>
  <Fragment set:html={body} />
</BaseLayout>

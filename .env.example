# Bot protection. These are Cloudflare's official always-pass test keys.
# Replace both with real keys before deploying.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Brevo. Use an API key (starts with xkeysib-), not an SMTP key.
# MAIL_FROM must be a verified sender in your Brevo account.
BREVO_API_KEY=
MAIL_FROM=website@axisiconstructure.com
MAIL_TO=info@axisiconstructure.com

# Local testing only: send to tools/brevo-mock.mjs. Remove this line in production.
# BREVO_API_URL=http://127.0.0.1:4555/v3/smtp/email
